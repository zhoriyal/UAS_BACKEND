# Template Environment Variables untuk Render.com (Free Web Service)
# Jangan isi PORT secara manual karena Render mengaturnya otomatis.

NODE_ENV=staging
TRUST_PROXY_HOPS=1

# Isi dengan URL MySQL gratis dari Aiven / TiDB Cloud (mis. mysql://user:pass@host:port/db?sslaccept=strict)
# Catatan: Render Free tidak memiliki disk persisten untuk SQLite; jika tetap pakai SQLite, data akan reset saat container restart.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict

JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ganti-password-admin

# Ganti dengan URL Render Anda & URL Vercel Admin Anda
PUBLIC_API_URL=https://museum-brawijaya-backend.onrender.com
CORS_ORIGINS=https://nama-admin-anda.vercel.app
ADMIN_FRONTEND_URL=https://nama-admin-anda.vercel.app
FRONTEND_URL=https://nama-app-anda.vercel.app

# Midtrans (Sandbox untuk staging, atau Live jika NODE_ENV=production)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME

# Opsional: Vercel Blob (disarankan agar foto yang diupload admin tetap tersimpan permanen)
BLOB_READ_WRITE_TOKEN=

# Opsional: Gemini AI & Google OAuth
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
