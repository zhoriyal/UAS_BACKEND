# Template Environment Variables untuk Railway (copy-paste ke tab Variables di Railway)
# Jangan isi PORT secara manual karena Railway mengaturnya otomatis.

# Gunakan "staging" jika masih memakai Midtrans Sandbox, atau "production" jika sudah memakai Midtrans Live + Vercel Blob
NODE_ENV=staging

# SQLite dengan Railway Volume di /app/prisma/data (atau ganti dengan URL MySQL Railway jika memakai MySQL)
DATABASE_URL=file:./data/museum.db

# Wajib diganti dengan secret acak yang panjang
JWT_SECRET=ganti-dengan-jwt-secret-acak-yang-panjang

# Akun admin awal
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ganti-password-admin

# Ganti dengan URL publik Railway & URL admin Vercel Anda
PUBLIC_API_URL=https://nama-service-anda.up.railway.app
CORS_ORIGINS=https://nama-admin-anda.vercel.app
ADMIN_FRONTEND_URL=https://nama-admin-anda.vercel.app
FRONTEND_URL=https://nama-app-anda.vercel.app

# Railway berjalan di balik reverse proxy
TRUST_PROXY_HOPS=1

# Midtrans (Sandbox untuk staging, atau Live untuk NODE_ENV=production)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME

# Opsional: Vercel Blob (wajib diisi jika NODE_ENV=production)
BLOB_READ_WRITE_TOKEN=

# Opsional: Gemini AI & Google OAuth
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
