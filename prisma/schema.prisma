generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  nama         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("admins")
}

model User {
  id           Int      @id @default(autoincrement())
  nama         String
  email        String   @unique
  passwordHash String?  @map("password_hash")
  authProvider String   @default("local") @map("auth_provider")
  avatarUrl    String?  @map("avatar_url")
  role         String   @default("USER")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("users")
}

model TicketCategory {
  id         Int      @id @default(autoincrement())
  badge      String
  badgeBg    String   @default("#fef3c7") @map("badge_bg")
  badgeColor String   @default("#92400e") @map("badge_color")
  title      String
  price      Int
  kuota      Int      @default(500)
  status     String   @default("Aktif")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("ticket_categories")
}

model TicketBooking {
  id              String    @id
  nama            String
  email           String
  phone           String?
  isMancanegara   Int       @default(0) @map("is_mancanegara")
  kategoriDewasa  Int       @default(0) @map("kategori_dewasa")
  kategoriPelajar Int       @default(0) @map("kategori_pelajar")
  kategoriWna     Int       @default(0) @map("kategori_wna")
  totalTiket      Int       @default(1) @map("total_tiket")
  totalBiaya      Int       @default(0) @map("total_biaya")
  sesi            String    @default("08:00 - 10:00")
  visitDate       String    @map("visit_date")
  paymentMethod   String    @default("QRIS") @map("payment_method")
  status          String    @default("MENUNGGU")
  checkedIn       Int       @default(0) @map("checked_in")
  checkedInAt     DateTime? @map("checked_in_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("ticket_bookings")
}

model Koleksi {
  id               Int      @id @default(autoincrement())
  kode             String   @unique
  nama             String
  subDeskripsi     String   @map("sub_deskripsi") @db.Text
  deskripsiLengkap String?  @map("deskripsi_lengkap") @db.Text
  kategori         String   @default("Kendaraan")
  tahun            String?
  lokasi           String?
  status           String   @default("DIPAMERKAN")
  imageUrl         String?  @map("image_url")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("koleksi")
}

model Ulasan {
  id            Int      @id @default(autoincrement())
  nama          String
  avatarInitial String   @default("?") @map("avatar_initial")
  avatarColor   String   @default("#3F5243") @map("avatar_color")
  category      String   @default("Kunjungan Umum")
  rating        Int      @default(5)
  comment       String   @db.Text
  reply         String?  @db.Text
  replyDate     String?  @map("reply_date")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("ulasan")
}

model Pengumuman {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  category    String
  date        String
  status      String   @default("AKTIF")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("pengumuman")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("faq")
}

model JamOperasional {
  id        Int      @id @default(autoincrement())
  hari      String
  jam       String
  telepon   String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("jam_operasional")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  otpCode   String   @map("otp_code")
  used      Int      @default(0)
  expiredAt DateTime @map("expired_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("password_resets")
}
