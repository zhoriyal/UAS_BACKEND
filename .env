NODE_ENV=development
PORT=3001

# SQLite database (tidak perlu MySQL/XAMPP)
DATABASE_URL=file:./data/museum.db

# JWT secret untuk autentikasi admin
JWT_SECRET=museum-brawijaya-secret-jwt-local-dev-2026

# Password awal admin (dipakai saat db:seed)
ADMIN_INITIAL_PASSWORD=admin123
ADMIN_INITIAL_USERNAME=admin

# CORS origins yang diizinkan
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Trust proxy
TRUST_PROXY_HOPS=0

# Midtrans sandbox (development)
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME
MIDTRANS_IS_PRODUCTION=false

# Gemini AI (opsional)
GEMINI_API_KEY=

# Public API URL
PUBLIC_API_URL=http://localhost:3001