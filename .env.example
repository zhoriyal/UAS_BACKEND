NODE_ENV=development
PORT=3001

# Use a publicly reachable MySQL endpoint in cloud hosting, never localhost/XAMPP.
DATABASE_URL=mysql://USER:PASSWORD@PUBLIC_MYSQL_HOST:3306/DATABASE
# Gemini API Key (keep private on backend only; kosongkan untuk memakai engine fallback lokal cerdas Museum Brawijaya).
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash-lite
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=replace-before-running-db-seed

# Vercel Blob read/write token (keep private; configure on the backend only).
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-read-write-token

# Use exact HTTPS frontend origins in production; localhost is allowed automatically in development.
CORS_ORIGINS=https://museum-brawijaya-admin.vercel.app
TRUST_PROXY_HOPS=0

# Sandbox defaults for local development. Set live credentials and true in production.
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME
MIDTRANS_IS_PRODUCTION=false
PUBLIC_API_URL=http://localhost:3001

# Google OAuth 2.0 Client ID (Web Application Client ID dari Google Cloud Console).
# Opsional: isi GOOGLE_CLIENT_IDS (dipisahkan koma) jika memakai Client ID terpisah untuk Android/iOS.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
